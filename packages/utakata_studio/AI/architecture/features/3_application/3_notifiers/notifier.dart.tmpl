//
// アプリケーション層の状態管理。
// Riverpod の AsyncNotifier を使用する。

import 'package:riverpod_annotation/riverpod_annotation.dart';

import '../../1_domain/1_entities/{{entity_name}}_entity.dart';
import '../../1_domain/2_repositories/{{entity_name}}_repository.dart';
import '{{feature_name}}_providers.dart';
import '{{feature_name}}_state.dart';

part '{{feature_name}}_notifier.g.dart';

@riverpod
class {{FeatureName}}Notifier extends void _${{FeatureName}}void Notifier {
  late {{EntityName}}Repository repository;

  @override
  {{FeatureName}}State build() {
    repository = ref.watch({{featureName}}RepositoryProvider);
    return const {{FeatureName}}State.initial();
  }

  Future<void> load(String id) async {
    state = const {{FeatureName}}State.loading();
    try {
      final result = await repository.findById(id);
      if (result != null) {
        state = {{FeatureName}}State.success(result);
      } else {
        state = const {{FeatureName}}State.error('データが見つかりません');
      }
    } catch (e) {
      state = {{FeatureName}}State.error(e.toString());
    }
  }
}
